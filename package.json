{
  "name": "horenso-space",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"next dev --turbopack\" \"pnpm lingui:watch\" \"pnpm gen-graphql --watch\"",
    "build": "next build --turbopack",
    "start": "next start",
    "lint": "biome check",
    "format": "biome format --write",
    "lint-types": "tsc --noEmit",
    "lingui:extract": "lingui extract",
    "lingui:watch": "lingui extract --watch",
    "gen-types": "supabase gen types typescript --local > src/@types/database.types.ts",
    "gen-graphql": "gql-gen --config tools/codegen.ts"
  },
  "dependencies": {
    "@apollo/client": "^4.1.4",
    "@apollo/client-integration-nextjs": "^0.14.4",
    "@lingui/core": "^5.7.0",
    "@lingui/macro": "^5.7.0",
    "@lingui/react": "^5.7.0",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/themes": "^3.2.1",
    "@sentry/nextjs": "^10.38.0",
    "@supabase/ssr": "0.7.0",
    "@supabase/supabase-js": "2.57.4",
    "@vercel/analytics": "^1.6.1",
    "@vladyoslav/drawer": "^0.1.0",
    "@xyflow/react": "^12.10.0",
    "clsx": "^2.1.1",
    "dagre": "^0.8.5",
    "fuse.js": "^7.1.0",
    "graphql": "^16.12.0",
    "gray-matter": "^4.0.3",
    "negotiator": "^0.6.3",
    "next": "16.1.1",
    "next-themes": "^0.4.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-virtuoso": "^4.17.0",
    "remark": "^15.0.1",
    "remark-gfm": "^4.0.1",
    "remark-html": "^16.0.1",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.0",
    "@graphql-codegen/cli": "^6.1.1",
    "@graphql-codegen/client-preset": "^5.2.2",
    "@graphql-typed-document-node/core": "^3.2.0",
    "@lingui/cli": "^5.7.0",
    "@lingui/loader": "^5.7.0",
    "@lingui/swc-plugin": "5.10.0",
    "@parcel/watcher": "^2.5.6",
    "@postgres-language-server/cli": "^0.19.0",
    "@swc-contrib/plugin-graphql-codegen-client-preset": "^0.17.0",
    "@types/dagre": "^0.7.53",
    "@types/negotiator": "^0.6.3",
    "@types/node": "^20",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "concurrently": "^9.2.1",
    "supabase": "^2.65.5",
    "typescript": "^5"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "19.2.7",
      "@types/react-dom": "19.2.3"
    }
  }
}
